{
  "extends": "./base.json",
  "compilerOptions": {
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "pretty": false,
    "module": "ES2020",
    "moduleResolution": "node",
    "sourceMap": true,
    "declaration": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": false
  }
}
