{
  "name": "@active-book/common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11"
  },
  "scripts": {
    "deps:sync": "node scripts/deps-sync.js",
    "check": "node scripts/check.js check",
    "typecheck": "node scripts/check.js typecheck",
    "lint": "node scripts/check.js lint",
    "lint:ts": "node scripts/check.js lint:ts",
    "lint:css": "node scripts/check.js lint:css",
    "test": "node scripts/check.js test",
    "test:unit": "node scripts/check.js test:unit",
    "test:component": "node scripts/check.js test:component",
    "test:browser": "node scripts/check.js test:browser",
    "test:infra": "node --test",
    "init:repo": "node scripts/init-repo.js"
  },
  "activeBook": {
    "repositories": {
      "active-book-types": "",
      "active-book-core": "",
      "active-book-editor": ""
    },
    "dependencies": {
      "classnames": "2.5.1",
      "react": "19.3.1",
      "react-dom": "19.3.1"
    },
    "devDependencies": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "eslint": "10.14.0",
      "playwright": "1.65.0",
      "stylelint": "16.26.1",
      "typescript": "5.9.3",
      "vitest": "4.1.12"
    },
    "checks": {
      "typecheck": [
        "typecheck",
        "typecheck:test"
      ],
      "lint": {
        "ts": [
          "lint:ts:check"
        ],
        "css": [
          "lint:css:check"
        ]
      },
      "test": {
        "unit": [
          "test:unit",
          "test:scripts",
          "test:scss-alias",
          "test:bundler"
        ],
        "component": [
          "test:component"
        ],
        "browser": [
          "test:browser",
          "test:runtime"
        ]
      }
    }
  },
  "exports": {
    "./eslint": "./configs/linters/eslint.js",
    "./stylelint": "./configs/linters/stylelint.js",
    "./tsconfig.base.json": "./configs/tsconfig/base.json",
    "./tsconfig.library.json": "./configs/tsconfig/library.json",
    "./tsconfig.app.json": "./configs/tsconfig/app.json",
    "./vitest": "./configs/vitest.ts",
    "./styles": "./styles/styles.scss"
  },
  "dependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/browser-playwright": "4.1.12",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-newline-destructuring": "1.2.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "stylelint-config-standard-scss": "16.0.0",
    "stylelint-declaration-block-no-ignored-properties": "2.8.0",
    "stylelint-order": "7.0.1",
    "stylelint-scss": "6.14.0"
  },
  "peerDependencies": {
    "eslint": "^10.14.0",
    "stylelint": "^16.26.1",
    "vitest": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "stylelint": "16.26.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
